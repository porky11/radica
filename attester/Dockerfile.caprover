# One container with a Freenet node and the attester, for CapRover (captain-definition at the repo root points here).
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl wget && rm -rf /var/lib/apt/lists/*
# Freenet's official installer: a prebuilt binary, no compiling (see freenet.org's "Run Freenet in Docker")
RUN curl -fsSL https://freenet.org/install.sh -o /tmp/install.sh \
 && FREENET_INSTALL_DIR=/usr/local/bin FREENET_NO_SERVICE=1 bash /tmp/install.sh && rm /tmp/install.sh
WORKDIR /app
COPY donate-app/src/lib.js donate-app/src/config.js donate-app/src/
COPY ui/src/log.wasm ui/src/
COPY attester/package.json attester/package-lock.json attester/
RUN cd attester && npm ci --omit=dev
COPY attester/src attester/src
COPY attester/start.sh /start.sh
WORKDIR /app/attester
ENV DATA_DIR=/data
CMD ["bash", "/start.sh"]

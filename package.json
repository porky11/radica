{
  "name": "spruce",
  "version": "5.0.0",
  "description": "A 100% decentralized social media platform powered by Freenet",
  "main": "./electron.js",
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "build:contract": "cargo build --manifest-path contract/Cargo.toml --target wasm32-unknown-unknown --release",
    "build": "npm run build:contract && npm run build:ui",
    "test": "npm run test:contract",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml",
    "app": "electron electron.js",
    "start": "npm --prefix ui run dev"
  },
  "keywords": [
    "freenet",
    "decentralized",
    "social-media",
    "p2p",
    "webassembly",
    "ed25519"
  ],
  "author": "Spruce Community",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
